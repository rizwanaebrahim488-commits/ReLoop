# ReLoop - Environment Configuration
# Copy this file to .env or .env.local and add your real Supabase credentials.

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon / Publishable Client Key (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Demo Mode fallback flag (if true or unset when env is empty, app uses resilient mock/demo local data so all 30 pages can be explored without a running Supabase instance)
VITE_ENABLE_DEMO_FALLBACK=true
